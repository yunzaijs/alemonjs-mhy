{
  "name": "alemonjs-mhy",
  "version": "0.0.7",
  "description": "mhy-mod",
  "author": "ningmengchongshui",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package": "./package.json"
  },
  "scripts": {
    "app": "node index.js",
    "dev": "npx lvy app.ts",
    "view": "npx lvy app.ts --jsxp",
    "lint": "eslint src --ext .ts,.tsx,.js --max-warnings=0",
    "lint:fix": "eslint src --ext .ts,.tsx,.js --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precommit": "lint-staged",
    "test:expose": "yarn build && node --test test/expose*.test.mjs"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "jsxp": "^1.3.0",
    "md5": "^2.3.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "alemonjs"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "bugs": "https://github.com/xiuxianjs/alemonjs-mhy/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiuxianjs/alemonjs-mhy.git"
  },
  "gitHead": "78509d7f628d169d67b6bdd87ff9cce27cbec9c0"
}
